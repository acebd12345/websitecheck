# 複製成 /home/hermesops/mailrelay/mailrelay.env,chmod 600,真值不得進 repo
# token 產生:python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_TOKEN=CHANGE_ME
RELAY_FROM=websitecheck@example.gov.taipei
RELAY_SMTP_HOST=mail-relay.example
RELAY_SMTP_PORT=25
# websitecheck 主機的對外 IP(若被 NAT 改寫,看 relay log 的 403 來源 IP 再填)
RELAY_ALLOW=
RELAY_TO_DOMAINS=gov.taipei,mail.taipei.gov.tw
RELAY_BIND=0.0.0.0:443
RELAY_CERT=/home/hermesops/mailrelay/cert.pem
RELAY_KEY=/home/hermesops/mailrelay/key.pem
RELAY_MAX_MB=20
